FROM python:3.11-slim

WORKDIR /app

# Копируем и устанавливаем зависимости с использованием BuildKit кэша
# Пакеты устанавливаются из pre-built wheels, поэтому тяжелые компиляторы (build-essential) не нужны,
# что экономит ~250 МБ размера образа и ускоряет сборку в разы.
COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt

# Копируем исходный код бэкенда
COPY app/ ./app/
COPY .env .env

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
